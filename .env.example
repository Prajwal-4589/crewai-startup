# Active LLM/provider for the whole crew. Managed from the web UI's
# "LLM & Model" tab (app.py writes back to this file), or edit by hand.
# LLM_MODEL uses LiteLLM-style model strings, e.g.:
#   openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
#   gpt-4o-mini
#   claude-sonnet-4-5-20250929
#   gemini/gemini-2.0-flash
#   ollama/llama3.1
LLM_PROVIDER_LABEL=OpenRouter — Nemotron 3 Ultra (free)
LLM_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.4

# Skip CrewAI's cloud tracing feature (not needed for local use).
CREWAI_TRACING_ENABLED=false

# Streamlit Community Cloud: paste these into the app's
# Settings → Secrets panel (they are injected as environment variables
# by app.py's bootstrap, so no .env file is needed in the cloud).
LLM_PROVIDER_LABEL = "OpenRouter — Nemotron 3 Ultra (free)"
LLM_MODEL = "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free"
LLM_API_KEY = "sk-or-v1-your-key-here"
LLM_BASE_URL = "https://openrouter.ai/api/v1"
LLM_TEMPERATURE = "0.4"
CREWAI_TRACING_ENABLED = "false"

# Optional: seed the entire fallback chain at once (several keys for the same
# free model, or a mix of providers). JSON array as a TOML multi-line string.
# Only used on first run, when llm_profiles.json does not exist yet.
LLM_PROFILES = '''[
  {"label": "OpenRouter #1", "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free", "base_url": "https://openrouter.ai/api/v1", "api_key": "sk-or-v1-key-one", "temperature": 0.4},
  {"label": "OpenRouter #2", "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free", "base_url": "https://openrouter.ai/api/v1", "api_key": "sk-or-v1-key-two", "temperature": 0.4}
]'''
